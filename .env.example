# ============================================
# 多模态 AI Agent 环境变量配置模板
# 使用说明：复制此文件为 .env，然后修改对应的值
# ============================================

# ---------- 模型配置 ----------
# Ollama 模型名称（支持切换任意 Ollama 支持的模型）
# 多模态模型示例：qwen3-vl:8b-instruct-q4_K_M
# 纯文本模型示例：llama3.2:3b, qwen2.5:7b, mistral:7b
OLLAMA_MODEL=qwen3-vl:8b-instruct-q4_K_M

# Embedding 模型（用于 RAG 向量检索）
EMBEDDING_MODEL=nomic-embed-text

# ---------- 网络配置 ----------
# Ollama 服务地址（宿主机 IP + 端口）
# 本地运行：http://localhost:11434
# Docker 容器内访问宿主机：http://host.docker.internal:11434
# 局域网访问：http://192.168.x.x:11434（替换为你的实际 IP）
OLLAMA_BASE_URL=http://localhost:11434

# ---------- 服务配置 ----------
# FastAPI 服务端口
PORT=8000

# 服务监听地址（0.0.0.0 表示监听所有网络接口）
HOST=0.0.0.0

# ---------- 路径配置 ----------
# Chroma 向量数据库路径
CHROMA_DB_PATH=./chroma_db

# 截图目录路径
SCREENSHOTS_PATH=./screenshots